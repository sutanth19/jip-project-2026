generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                           String                         @id @default(uuid()) @db.Uuid
  role                         UserRole
  email                        String?                        @unique
  passwordHash                 String?
  accountStatus                AccountStatus                  @default(PENDING)
  isFirstLogin                 Boolean                        @default(true)
  lastLogin                    DateTime?
  passwordResetToken           String?                        @unique
  passwordResetExpiry          DateTime?
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt
  setupToken                   String?                        @unique
  setupTokenExpiry             DateTime?
  admin                        Admin?
  parent                       Parent?
  student                      Student?
  teacher                      Teacher?
  auditLogs                    AuditLog[]
  questionBankItems            QuestionBankItem[]
  digitalActivitiesCreated     DigitalActivity[]              @relation("DigitalActivityCreatedBy")
  digitalActivitiesUpdated     DigitalActivity[]              @relation("DigitalActivityUpdatedBy")
  digitalActivityReviewHistory DigitalActivityReviewHistory[]
  aiPromptTemplatesCreated     AiPromptTemplate[]             @relation("AiPromptCreatedBy")
  aiPromptTemplatesActivated   AiPromptTemplate[]             @relation("AiPromptActivatedBy")
  aiRequests                   AiRequest[]                    @relation("AiRequestedBy")
  aiOutputsReviewed            AiGeneratedOutput[]            @relation("AiOutputReviewedBy")
  notificationRecipients       NotificationRecipient[]
  notificationPreferences      NotificationPreference?
  notificationsCreated         Notification[]                 @relation("NotificationCreatedBy")
  announcementsCreated         Announcement[]                 @relation("AnnouncementCreatedBy")

  @@map("users")
}

model School {
  id                  String               @id @default(uuid()) @db.Uuid
  schoolCode          String               @unique
  schoolName          String               @unique
  logo                String?
  principalName       String?
  address             String
  phone               String
  contactEmail        String?              @unique
  accountStatus       AccountStatus        @default(ACTIVE)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  admins              Admin[]
  classes             SchoolClass[]
  students            Student[]
  teachers            Teacher[]
  assignments         Assignment[]
  submissions         Submission[]
  assessments         Assessment[]
  auditLogs           AuditLog[]
  pbdEvidence         PBDEvidence[]
  masteries           StudentMastery[]
  aiRequests          AiRequest[]
  aiUsageDaily        AiUsageDaily[]
  notifications       Notification[]
  announcements       Announcement[]
  announcementTargets AnnouncementTarget[]

  @@map("schools")
}

model Teacher {
  id                 String                   @id @default(uuid()) @db.Uuid
  userId             String                   @unique @db.Uuid
  schoolId           String                   @db.Uuid
  teacherId          String
  fullName           String
  gender             Gender
  phone              String?                  @unique
  position           String?
  avatar             String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  classes            SchoolClass[]
  assignments        Assignment[]
  reviews            TeacherReview[]
  itemReviews        SubmissionItemReview[]
  assessments        Assessment[]
  assessmentItems    AssessmentItem[]
  adjustments        AssessmentAdjustment[]
  permissionGrants   TeacherPermissionGrant[]
  pbdEvidence        PBDEvidence[]
  confirmedMasteries StudentMastery[]         @relation("MasteryConfirmedBy")
  masteryHistory     StudentMasteryHistory[]
  school             School                   @relation(fields: [schoolId], references: [id])
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([schoolId, teacherId])
  @@map("teachers")
}

model SchoolClass {
  id                     String                  @id @default(uuid()) @db.Uuid
  schoolId               String                  @db.Uuid
  teacherId              String                  @db.Uuid
  className              String
  yearLevel              Int
  academicYear           Int
  capacity               Int?
  accountStatus          AccountStatus           @default(ACTIVE)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  normalizedClassName    String
  school                 School                  @relation(fields: [schoolId], references: [id])
  teacher                Teacher                 @relation(fields: [teacherId], references: [id])
  students               Student[]
  assignmentClassTargets AssignmentClassTarget[]
  announcementTargets    AnnouncementTarget[]

  @@unique([schoolId, academicYear, yearLevel, normalizedClassName])
  @@index([schoolId])
  @@index([teacherId])
  @@map("school_classes")
}

model Student {
  id                       String                    @id @default(uuid()) @db.Uuid
  userId                   String                    @unique @db.Uuid
  schoolId                 String                    @db.Uuid
  classId                  String                    @db.Uuid
  remedialSkillId          String?                   @db.Uuid
  studentId                String
  fullName                 String
  gender                   Gender
  birthDate                DateTime?
  pinHash                  String
  avatar                   String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  isPinChanged             Boolean                   @default(false)
  pinUpdatedAt             DateTime?
  parents                  ParentStudent[]
  assignmentStudentTargets AssignmentStudentTarget[]
  attempts                 StudentAttempt[]
  submissions              Submission[]
  assessments              Assessment[]
  pbdEvidence              PBDEvidence[]
  masteries                StudentMastery[]
  aiRequests               AiRequest[]
  class                    SchoolClass               @relation(fields: [classId], references: [id])
  remedialSkill            RemedialSkill?            @relation(fields: [remedialSkillId], references: [id], onDelete: SetNull)
  school                   School                    @relation(fields: [schoolId], references: [id])
  user                     User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([schoolId, studentId])
  @@index([classId])
  @@index([remedialSkillId])
  @@map("students")
}

model Parent {
  id         String          @id @default(uuid()) @db.Uuid
  userId     String          @unique @db.Uuid
  fullName   String
  phone      String          @unique
  occupation String?
  address    String?
  avatar     String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  students   ParentStudent[]
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("parents")
}

model ParentStudent {
  id           String             @id @default(uuid()) @db.Uuid
  parentId     String             @db.Uuid
  studentId    String             @db.Uuid
  relationship ParentRelationship
  createdAt    DateTime           @default(now())
  parent       Parent             @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student      Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([parentId])
  @@index([studentId])
  @@map("parent_students")
}

model Admin {
  id                        String                   @id @default(uuid()) @db.Uuid
  userId                    String                   @unique @db.Uuid
  schoolId                  String?                  @db.Uuid
  fullName                  String
  phone                     String?
  position                  String?
  avatar                    String?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  school                    School?                  @relation(fields: [schoolId], references: [id])
  grantedTeacherPermissions TeacherPermissionGrant[]
  user                      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("admins")
}

model TeacherPermissionGrant {
  id          String            @id @default(uuid()) @db.Uuid
  teacherId   String            @db.Uuid
  grantedById String            @db.Uuid
  permission  TeacherPermission
  expiresAt   DateTime?
  maxUses     Int               @default(1)
  usedCount   Int               @default(0)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  grantedBy Admin   @relation(fields: [grantedById], references: [id], onDelete: Restrict)

  @@index([teacherId])
  @@index([grantedById])
  @@index([permission, isActive])
  @@map("teacher_permission_grants")
}

model AuditLog {
  id                     String    @id @default(uuid()) @db.Uuid
  actorUserId            String?   @db.Uuid
  actorProfileId         String?   @db.Uuid
  actorRole              UserRole?
  actorName              String?
  action                 String
  resourceType           String
  resourceId             String?
  schoolId               String?   @db.Uuid
  beforeData             Json?
  afterData              Json?
  metadata               Json?
  ipAddress              String?
  userAgent              String?
  requestId              String?
  restrictedToSuperAdmin Boolean   @default(false)
  createdAt              DateTime  @default(now())

  actorUser User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  school    School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([actorRole])
  @@index([action])
  @@index([resourceType])
  @@index([resourceId])
  @@index([schoolId])
  @@index([createdAt])
  @@index([resourceType, action])
  @@index([schoolId, createdAt])
  @@index([restrictedToSuperAdmin, createdAt])
  @@map("audit_logs")
}

model CurriculumVersion {
  id            String           @id @default(uuid()) @db.Uuid
  code          String           @unique
  name          String
  description   String?
  sourceYear    Int?
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  status        CurriculumStatus @default(DRAFT)
  publishedAt   DateTime?
  archivedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  programmes  CurriculumProgramme[]
  pbdEvidence PBDEvidence[]
  masteries   StudentMastery[]
  aiRequests  AiRequest[]

  @@index([status])
  @@index([sourceYear])
  @@map("curriculum_versions")
}

model Subject {
  id          String                 @id @default(uuid()) @db.Uuid
  code        String                 @unique
  name        String                 @unique
  description String?
  status      CurriculumRecordStatus @default(ACTIVE)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  programmes CurriculumProgramme[]

  @@index([status])
  @@map("subjects")
}

model CurriculumProgramme {
  id                  String                 @id @default(uuid()) @db.Uuid
  curriculumVersionId String                 @db.Uuid
  subjectId           String                 @db.Uuid
  code                String
  name                String
  description         String?
  status              CurriculumRecordStatus @default(ACTIVE)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  curriculumVersion  CurriculumVersion   @relation(fields: [curriculumVersionId], references: [id], onDelete: Restrict)
  subject            Subject             @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  years              CurriculumYear[]
  languageStructures LanguageStructure[]
  remedialSkills     RemedialSkill[]
  contentStandards   ContentStandard[]
  questionBankItems  QuestionBankItem[]
  digitalActivities  DigitalActivity[]
  pbdEvidence        PBDEvidence[]
  masteries          StudentMastery[]
  aiRequests         AiRequest[]

  @@unique([curriculumVersionId, code])
  @@index([subjectId])
  @@index([status])
  @@map("curriculum_programmes")
}

model CurriculumYear {
  id          String                 @id @default(uuid()) @db.Uuid
  programmeId String                 @db.Uuid
  yearLevel   Int
  name        String
  sequence    Int
  status      CurriculumRecordStatus @default(ACTIVE)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  programme                      CurriculumProgramme             @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  contentStandards               ContentStandard[]
  questionBankCurriculumLinks    QuestionBankCurriculumLink[]
  digitalActivityCurriculumLinks DigitalActivityCurriculumLink[]

  @@unique([programmeId, yearLevel])
  @@unique([programmeId, sequence])
  @@index([status])
  @@map("curriculum_years")
}

model LanguageStructure {
  id          String                 @id @default(uuid()) @db.Uuid
  programmeId String                 @db.Uuid
  code        String
  name        String
  description String?
  sequence    Int
  status      CurriculumRecordStatus @default(ACTIVE)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  programme                      CurriculumProgramme             @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  remedialSkills                 RemedialSkill[]
  digitalActivityCurriculumLinks DigitalActivityCurriculumLink[]

  @@unique([programmeId, code])
  @@unique([programmeId, sequence])
  @@index([status])
  @@map("language_structures")
}

model RemedialSkill {
  id                  String                 @id @default(uuid()) @db.Uuid
  programmeId         String                 @db.Uuid
  languageStructureId String                 @db.Uuid
  code                String
  sequence            Int
  name                String
  description         String?
  isPreparatory       Boolean                @default(false)
  status              CurriculumRecordStatus @default(ACTIVE)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  programme                      CurriculumProgramme             @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  languageStructure              LanguageStructure               @relation(fields: [languageStructureId], references: [id], onDelete: Restrict)
  standardMappings               RemedialSkillStandardMapping[]
  learningObjectives             LearningObjective[]
  suggestedActivities            SuggestedTeachingActivity[]
  questionBankCurriculumLinks    QuestionBankCurriculumLink[]
  digitalActivityCurriculumLinks DigitalActivityCurriculumLink[]
  pbdEvidence                    PBDEvidence[]
  masteries                      StudentMastery[]
  students                       Student[]
  aiRequests                     AiRequest[]

  @@unique([programmeId, code])
  @@unique([programmeId, sequence])
  @@index([languageStructureId])
  @@index([status])
  @@map("remedial_skills")
}

model ContentStandard {
  id               String                 @id @default(uuid()) @db.Uuid
  programmeId      String                 @db.Uuid
  curriculumYearId String                 @db.Uuid
  code             String
  title            String
  description      String?
  domain           CurriculumDomain
  sequence         Int?
  status           CurriculumRecordStatus @default(ACTIVE)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  programme                      CurriculumProgramme             @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  curriculumYear                 CurriculumYear                  @relation(fields: [curriculumYearId], references: [id], onDelete: Restrict)
  learningStandards              LearningStandard[]
  questionBankCurriculumLinks    QuestionBankCurriculumLink[]
  digitalActivityCurriculumLinks DigitalActivityCurriculumLink[]

  @@unique([programmeId, curriculumYearId, code])
  @@index([domain])
  @@index([status])
  @@map("content_standards")
}

model LearningStandard {
  id                String                 @id @default(uuid()) @db.Uuid
  contentStandardId String                 @db.Uuid
  code              String
  description       String
  sequence          Int?
  status            CurriculumRecordStatus @default(ACTIVE)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  contentStandard                ContentStandard                 @relation(fields: [contentStandardId], references: [id], onDelete: Restrict)
  remedialMappings               RemedialSkillStandardMapping[]
  questionBankCurriculumLinks    QuestionBankCurriculumLink[]
  digitalActivityCurriculumLinks DigitalActivityCurriculumLink[]
  pbdEvidence                    PBDEvidence[]
  masteries                      StudentMastery[]

  @@unique([contentStandardId, code])
  @@index([status])
  @@map("learning_standards")
}

model RemedialSkillStandardMapping {
  id                 String   @id @default(uuid()) @db.Uuid
  remedialSkillId    String   @db.Uuid
  learningStandardId String   @db.Uuid
  isPrimary          Boolean  @default(false)
  notes              String?
  createdAt          DateTime @default(now())

  remedialSkill    RemedialSkill    @relation(fields: [remedialSkillId], references: [id], onDelete: Cascade)
  learningStandard LearningStandard @relation(fields: [learningStandardId], references: [id], onDelete: Cascade)

  @@unique([remedialSkillId, learningStandardId])
  @@index([learningStandardId])
  @@map("remedial_skill_standard_mappings")
}

model LearningObjective {
  id              String                 @id @default(uuid()) @db.Uuid
  remedialSkillId String                 @db.Uuid
  code            String?
  description     String
  sequence        Int
  status          CurriculumRecordStatus @default(ACTIVE)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  remedialSkill                  RemedialSkill                   @relation(fields: [remedialSkillId], references: [id], onDelete: Cascade)
  suggestedActivities            SuggestedTeachingActivity[]
  digitalActivityCurriculumLinks DigitalActivityCurriculumLink[]
  pbdEvidence                    PBDEvidence[]

  @@unique([remedialSkillId, sequence])
  @@index([status])
  @@map("learning_objectives")
}

model SuggestedTeachingActivity {
  id                  String                 @id @default(uuid()) @db.Uuid
  remedialSkillId     String                 @db.Uuid
  learningObjectiveId String?                @db.Uuid
  title               String?
  description         String
  sequence            Int
  sourceReference     String?
  status              CurriculumRecordStatus @default(ACTIVE)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  remedialSkill     RemedialSkill      @relation(fields: [remedialSkillId], references: [id], onDelete: Cascade)
  learningObjective LearningObjective? @relation(fields: [learningObjectiveId], references: [id], onDelete: SetNull)

  @@unique([remedialSkillId, sequence])
  @@index([learningObjectiveId])
  @@index([status])
  @@map("suggested_teaching_activities")
}

model QuestionBankItem {
  id              String               @id @default(uuid()) @db.Uuid
  programmeId     String               @db.Uuid
  createdByUserId String               @db.Uuid
  type            QuestionBankItemType
  title           String?
  content         String
  normalizedText  String?
  languagePattern String?
  instructions    String?
  explanation     String?
  answerType      QuestionAnswerType   @default(NONE)
  correctAnswer   Json?
  difficulty      DifficultyLevel
  status          QuestionBankStatus   @default(DRAFT)
  sourceReference String?
  metadata        Json?
  publishedAt     DateTime?
  archivedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  programme            CurriculumProgramme          @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  createdBy            User                         @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  curriculumLinks      QuestionBankCurriculumLink[]
  mediaLinks           QuestionBankMedia[]
  answerOptions        QuestionBankAnswerOption[]
  digitalActivityItems DigitalActivityItem[]

  @@index([programmeId])
  @@index([createdByUserId])
  @@index([type])
  @@index([difficulty])
  @@index([status])
  @@index([normalizedText])
  @@index([createdAt])
  @@map("question_bank_items")
}

model QuestionBankCurriculumLink {
  id                 String   @id @default(uuid()) @db.Uuid
  questionBankItemId String   @db.Uuid
  remedialSkillId    String?  @db.Uuid
  contentStandardId  String?  @db.Uuid
  learningStandardId String?  @db.Uuid
  curriculumYearId   String?  @db.Uuid
  isPrimary          Boolean  @default(false)
  createdAt          DateTime @default(now())

  questionBankItem QuestionBankItem  @relation(fields: [questionBankItemId], references: [id], onDelete: Cascade)
  remedialSkill    RemedialSkill?    @relation(fields: [remedialSkillId], references: [id], onDelete: Restrict)
  contentStandard  ContentStandard?  @relation(fields: [contentStandardId], references: [id], onDelete: Restrict)
  learningStandard LearningStandard? @relation(fields: [learningStandardId], references: [id], onDelete: Restrict)
  curriculumYear   CurriculumYear?   @relation(fields: [curriculumYearId], references: [id], onDelete: Restrict)

  @@index([questionBankItemId])
  @@index([remedialSkillId])
  @@index([contentStandardId])
  @@index([learningStandardId])
  @@index([curriculumYearId])
  @@map("question_bank_curriculum_links")
}

model QuestionBankAnswerOption {
  id                 String   @id @default(uuid()) @db.Uuid
  questionBankItemId String   @db.Uuid
  label              String?
  content            String
  isCorrect          Boolean  @default(false)
  sequence           Int
  metadata           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  questionBankItem QuestionBankItem @relation(fields: [questionBankItemId], references: [id], onDelete: Cascade)

  @@unique([questionBankItemId, sequence])
  @@index([questionBankItemId])
  @@map("question_bank_answer_options")
}

model QuestionBankMedia {
  id                 String    @id @default(uuid()) @db.Uuid
  questionBankItemId String    @db.Uuid
  mediaKey           String
  mediaRole          MediaRole
  mimeType           String?
  originalName       String?
  sequence           Int       @default(0)
  altText            String?
  createdAt          DateTime  @default(now())

  questionBankItem QuestionBankItem @relation(fields: [questionBankItemId], references: [id], onDelete: Cascade)

  @@unique([questionBankItemId, mediaRole, sequence])
  @@index([questionBankItemId])
  @@index([mediaRole])
  @@map("question_bank_media")
}

model ActivityTemplate {
  id                     String                   @id @default(uuid()) @db.Uuid
  code                   String                   @unique
  name                   String
  description            String?
  category               ActivityTemplateCategory
  version                Int                      @default(1)
  status                 ActivityTemplateStatus   @default(ACTIVE)
  assessmentMode         AssessmentMode
  requiresTeacherReview  Boolean                  @default(false)
  supportsAutoMarking    Boolean                  @default(false)
  supportsMedia          Boolean                  @default(false)
  supportsAudio          Boolean                  @default(false)
  supportsVideo          Boolean                  @default(false)
  supportsDrawing        Boolean                  @default(false)
  supportsVoiceRecording Boolean                  @default(false)
  supportsFutureAI       Boolean                  @default(false)
  configurationSchema    Json
  contentSchema          Json
  rendererKey            String
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  acceptedItemTypes ActivityTemplateItemType[]
  digitalActivities DigitalActivity[]

  @@index([category])
  @@index([status])
  @@index([rendererKey])
  @@map("activity_templates")
}

model ActivityTemplateItemType {
  id                 String               @id @default(uuid()) @db.Uuid
  activityTemplateId String               @db.Uuid
  itemType           QuestionBankItemType
  isRequired         Boolean              @default(false)
  minimumItems       Int?
  maximumItems       Int?
  createdAt          DateTime             @default(now())

  activityTemplate ActivityTemplate @relation(fields: [activityTemplateId], references: [id], onDelete: Cascade)

  @@unique([activityTemplateId, itemType])
  @@index([activityTemplateId])
  @@map("activity_template_item_types")
}

model DigitalActivity {
  id                    String                @id @default(uuid()) @db.Uuid
  code                  String                @unique
  title                 String
  description           String?
  instructions          String
  learningOutcome       String?
  programmeId           String                @db.Uuid
  activityTemplateId    String                @db.Uuid
  createdByUserId       String                @db.Uuid
  updatedByUserId       String?               @db.Uuid
  difficulty            LearningDifficulty
  status                DigitalActivityStatus @default(DRAFT)
  scoringMode           ActivityScoringMode
  reviewMode            ActivityReviewMode
  totalMarks            Int?
  masteryThreshold      Int?
  estimatedMinutes      Int?
  attemptsAllowed       Int?
  timeLimitSeconds      Int?
  shuffleItems          Boolean               @default(false)
  showImmediateFeedback Boolean               @default(false)
  allowRetry            Boolean               @default(true)
  configuration         Json
  rewardConfiguration   Json?
  presentationSettings  Json?
  settingsCompletedAt   DateTime?
  submittedForReviewAt  DateTime?
  publishedAt           DateTime?
  archivedAt            DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  programme        CurriculumProgramme             @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  activityTemplate ActivityTemplate                @relation(fields: [activityTemplateId], references: [id], onDelete: Restrict)
  createdBy        User                            @relation("DigitalActivityCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy        User?                           @relation("DigitalActivityUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  curriculumLinks  DigitalActivityCurriculumLink[]
  items            DigitalActivityItem[]
  mediaLinks       DigitalActivityMedia[]
  reviewHistory    DigitalActivityReviewHistory[]
  assignments      Assignment[]
  pbdEvidence      PBDEvidence[]

  @@index([programmeId])
  @@index([activityTemplateId])
  @@index([createdByUserId])
  @@index([difficulty])
  @@index([status])
  @@index([createdAt])
  @@map("digital_activities")
}

model DigitalActivityCurriculumLink {
  id                  String   @id @default(uuid()) @db.Uuid
  digitalActivityId   String   @db.Uuid
  curriculumYearId    String?  @db.Uuid
  languageStructureId String?  @db.Uuid
  remedialSkillId     String?  @db.Uuid
  contentStandardId   String?  @db.Uuid
  learningStandardId  String?  @db.Uuid
  learningObjectiveId String?  @db.Uuid
  isPrimary           Boolean  @default(false)
  createdAt           DateTime @default(now())

  digitalActivity   DigitalActivity    @relation(fields: [digitalActivityId], references: [id], onDelete: Cascade)
  curriculumYear    CurriculumYear?    @relation(fields: [curriculumYearId], references: [id], onDelete: Restrict)
  languageStructure LanguageStructure? @relation(fields: [languageStructureId], references: [id], onDelete: Restrict)
  remedialSkill     RemedialSkill?     @relation(fields: [remedialSkillId], references: [id], onDelete: Restrict)
  contentStandard   ContentStandard?   @relation(fields: [contentStandardId], references: [id], onDelete: Restrict)
  learningStandard  LearningStandard?  @relation(fields: [learningStandardId], references: [id], onDelete: Restrict)
  learningObjective LearningObjective? @relation(fields: [learningObjectiveId], references: [id], onDelete: Restrict)

  @@index([digitalActivityId])
  @@index([curriculumYearId])
  @@index([languageStructureId])
  @@index([remedialSkillId])
  @@index([contentStandardId])
  @@index([learningStandardId])
  @@index([learningObjectiveId])
