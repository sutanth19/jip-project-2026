PORT=3001

DATABASE_URL="postgresql://user:password@localhost:5432/digital_molib_dev"

JWT_SECRET="replace-with-a-strong-development-secret"
JWT_EXPIRES_IN="7d"
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_ACCESS_EXPIRES_IN="15m"

BCRYPT_SALT_ROUNDS=12
ADMIN_SETUP_TOKEN_EXPIRES_HOURS=24
TEACHER_SETUP_TOKEN_EXPIRES_HOURS=24

# Local media storage (development default). Paths are relative to backend/.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=storage/uploads
STORAGE_PUBLIC_BASE_URL=/api/media/files
MAX_IMAGE_UPLOAD_MB=5
MAX_DOCUMENT_UPLOAD_MB=20
MAX_AUDIO_UPLOAD_MB=25
MAX_VIDEO_UPLOAD_MB=100
MAX_TRACING_UPLOAD_MB=10

# Retention is policy documentation only in Phase 13; no deletion job runs yet.
AUDIT_RETENTION_DAYS=2555

SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
SEED_SUPER_ADMIN_PASSWORD=replace-with-a-strong-development-password
SEED_SUPER_ADMIN_NAME=System Super Admin
