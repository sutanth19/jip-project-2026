PORT=3001

DATABASE_URL="postgresql://user:password@localhost:5432/digital_molib_dev"

JWT_SECRET="replace-with-a-strong-development-secret"
JWT_EXPIRES_IN="7d"
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_ACCESS_EXPIRES_IN="15m"

BCRYPT_SALT_ROUNDS=12
ADMIN_SETUP_TOKEN_EXPIRES_HOURS=24
TEACHER_SETUP_TOKEN_EXPIRES_HOURS=24

# Account setup email delivery through Resend.
# RESEND_API_KEY must be a server-side API key. EMAIL_FROM must be a verified
# Resend sender address or verified domain sender.
RESEND_API_KEY=
EMAIL_FROM=no-reply@digitalmolib.edu.my
FRONTEND_URL=http://localhost:5173

# Local media storage (development default). Paths are relative to backend/.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=storage/uploads
STORAGE_PUBLIC_BASE_URL=/api/media/files
MAX_IMAGE_UPLOAD_MB=5
MAX_DOCUMENT_UPLOAD_MB=20
MAX_AUDIO_UPLOAD_MB=25
MAX_VIDEO_UPLOAD_MB=100
MAX_TRACING_UPLOAD_MB=10

# Retention is policy documentation only in Phase 13; no deletion job runs yet.
AUDIT_RETENTION_DAYS=2555

# Gemini is backend-only. Restrict the key in Google Cloud / AI Studio to this server workload.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=
GEMINI_FAST_MODEL=
GEMINI_AUDIO_MODEL=
GEMINI_EMBEDDING_MODEL=
GEMINI_REQUEST_TIMEOUT_MS=30000
GEMINI_MAX_RETRIES=2
GEMINI_AI_ENABLED=false
GEMINI_DAILY_REQUEST_LIMIT=
GEMINI_DAILY_TOKEN_LIMIT=
GEMINI_MONTHLY_BUDGET_MYR=
GEMINI_LOG_PROMPTS=false
GEMINI_STORE_RAW_OUTPUT=false

SEED_SUPER_ADMIN_EMAIL=superadmin@digitalmolib.edu.my
SEED_SUPER_ADMIN_PASSWORD=Admin@123
SEED_SUPER_ADMIN_NAME=System Super Admin
